# ─── Database (Neon, Vercel Marketplace) ───
# Provisioned automatically by `vercel integration add neon`.
DATABASE_URL=
# Direct (non-pooled) connection, used by drizzle-kit migrations
DATABASE_URL_UNPOOLED=

# ─── Better Auth ───
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin of the app. Must match the OAuth redirect URI host.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Google OAuth ───
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorised redirect URI must be exactly:
#   <BETTER_AUTH_URL>/api/auth/callback/google
# e.g. https://navio.az/api/auth/callback/google
# Leave both blank to hide the Google button until credentials are issued.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (Resend, Vercel Marketplace) — OPTIONAL ───
# Leave BLANK to switch email off entirely. With no key the app sends nothing and
# hides what it cannot deliver: no confirmation mail, no "forgot password" link.
# Set it (and verify a sending domain in Resend) to turn both on. No code change needed.
RESEND_API_KEY=
# Only used when RESEND_API_KEY is set. Must be a domain verified in Resend.
EMAIL_FROM=Navio <noreply@navio.az>

# ─── Scoring privacy (optional) ───
# Salt for hashing visitor IPs. We never store a raw IP — only SHA-256(salt+ip),
# used to rate-limit abuse and to attribute analytics rows.
#
# The salt is what makes that hash meaningful: IPv4 has only ~4.3 billion
# possible values, so an unsalted hash of an address can be brute-forced back to
# the original in minutes. The salt lives in the environment, not the database,
# so leaking the database alone does not reveal anyone's address.
#
# Optional: if unset, it is derived from BETTER_AUTH_SECRET, which is required
# anyway. Set it explicitly only if you want IP hashing independent of the auth
# secret. Changing either value resets rate-limit counters, which is harmless.
SCORING_IP_SALT=

# ─── Admin panel ───
# Admins are NOT site users and cannot register.
#
# On a server (no terminal needed): set ADMIN_BOOTSTRAP_TOKEN to any long random
# value, redeploy, then open
#   https://<your-domain>/admin/bootstrap?token=<that value>
# Fill in email + password, scan the QR shown, save the backup codes. The page
# then closes itself permanently, because an admin now exists. Remove the token
# afterwards; it has no further use.
#
# Locally, or for extra admins later, use the script instead:
#   npm run admin:seed -- admin@navio.az "Full Name"
#
# Leaving ADMIN_BOOTSTRAP_TOKEN unset means setup is CLOSED. That is deliberate:
# without it, anyone hitting /admin/bootstrap on a fresh deploy would become
# administrator. Two-factor authentication is mandatory either way.
ADMIN_BOOTSTRAP_TOKEN=
