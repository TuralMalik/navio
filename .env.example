# ─── Database (Neon, Vercel Marketplace) ───
# Provisioned automatically by `vercel integration add neon`.
DATABASE_URL=
# Direct (non-pooled) connection, used by drizzle-kit migrations
DATABASE_URL_UNPOOLED=

# ─── Better Auth ───
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin of the app. Must match the OAuth redirect URI host.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Google OAuth ───
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorised redirect URI must be exactly:
#   <BETTER_AUTH_URL>/api/auth/callback/google
# e.g. https://navio.az/api/auth/callback/google
# Leave both blank to hide the Google button until credentials are issued.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (Resend, Vercel Marketplace) ───
# Verification and password-reset mail. Without a key, mail is logged instead of sent.
RESEND_API_KEY=
# Must be a domain verified in Resend once out of testing.
EMAIL_FROM=Navio <noreply@navio.az>

# ─── Scoring privacy ───
# Salt for hashing IPs used only for rate limiting. Required in production.
# Generate the same way as BETTER_AUTH_SECRET. Changing it resets rate-limit counters.
SCORING_IP_SALT=
